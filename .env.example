# Optional — copy to .env.local and change these if you want. The app
# works with zero setup using the built-in defaults below.

# The passcode typed on the login screen. Defaults to "0000" if unset.
APP_PASSWORD="0000"

# Secret used to sign the login cookie. Defaults to a baked-in value if
# unset — fine for personal/low-stakes use, but set your own random string
# (e.g. `openssl rand -base64 32`) for a public deployment.
AUTH_SECRET="change-me-to-something-random"

# --- Data storage --------------------------------------------------------
# Without these, memos are saved to a local JSON file (data/todos.json).
# That's fine for local dev or an always-on server, but Vercel's serverless
# functions don't have a durable disk, so memos there would reset.
#
# To persist on Vercel: dashboard → your project → Storage tab →
# Create Database → Redis, then "Connect to Project". Vercel injects
# KV_REST_API_URL / KV_REST_API_TOKEN automatically — you don't need to
# set them here yourself; this is just documenting what appears.
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# Same idea for uploaded images (the "이미지" tab): without this, images
# are saved under data/images/ locally, which won't survive on Vercel.
# To persist there: Storage tab → Create Database → Blob → Connect to
# Project. Vercel injects BLOB_READ_WRITE_TOKEN automatically.
# BLOB_READ_WRITE_TOKEN=""


# --- iPhone Shortcuts widget (/api/widget) --------------------------------
# Unset by default, which disables the endpoint entirely (501). Set this to
# a random string to enable it, then use that same string as the `token`
# query param from a Shortcuts "Get Contents of URL" action. This bypasses
# the login-password gate for read-only access to that day's memos, so
# treat it like a password — don't reuse APP_PASSWORD/AUTH_SECRET here.
# Generate one with `openssl rand -hex 16`.
# WIDGET_TOKEN=""
